# ==============================================================================
# skills-bank - Environment Variables Template (.env.example)
# ==============================================================================
# Usage:
#   cp .env.example .env
#
# IMPORTANT:
#   Never commit the actual .env file containing live API keys to version control.
# ==============================================================================

# Core Pipeline Settings
LLM_ENABLED=true
LLM_BATCH_SIZE=10
LLM_CONCURRENCY=5
LLM_MAX_RETRIES=3
LLM_INITIAL_BACKOFF_MS=500
LLM_MAX_BACKOFF_MS=10000
LLM_TIMEOUT_SECS=30

# LLM Routing & Provider Hierarchy
GV_PROVIDER_PRIMARY=groq
GV_PROVIDER_FALLBACKS=mistral,sambanova,cerebras,hyperbolic,cloudflare,memos,ollama
CEREBRAS_MODEL=gpt-oss-120b
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Provider API Credentials (Populate as needed)
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
SAMBANOVA_API_KEY=your_sambanova_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://agentrouter.org/
AWS_BEARER_TOKEN_BEDROCK=
GITHUB_TOKEN=your_github_token_here
HYPERBOLIC_API_TOKEN=your_hyperbolic_token_here
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
COMETAPI_KEY=your_cometapi_key_here

# Local & Self-Hosted Providers
MEMOS_API_KEY=your_memos_api_key_here
MEMOS_PROXY_PORT=11435
OLLAMA_HOST=http://localhost:11434
